# Artsheaven environment template
#
# Copy the frontend section to `.env.local` in the repository root:
#   cp .env.example .env.local
#
# Copy the API section to `apps/api/.env` (never commit either file):
#   cp apps/api/.env.example apps/api/.env
#
# All values below are placeholders for local/sandbox use. Generate real
# secrets and inject them from a secret manager in production.

# --- Storefront (Vite) -------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- API --------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:5173,http://localhost:8080
API_URL=http://localhost:4000/api/v1

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL="postgresql://artsheaven:artsheaven@localhost:5432/artsheaven?schema=public"

# --- Auth (rotate every value) ------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_TTL=7d
JWT_EMAIL_VERIFY_SECRET=replace-with-email-verify-secret
JWT_PASSWORD_RESET_SECRET=replace-with-password-reset-secret
BCRYPT_ROUNDS=12

# --- Redis / BullMQ ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- AWS S3 (private bucket; no credentials in the frontend) ------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=artsheaven-dev
AWS_S3_PUBLIC_BASE_URL=

# --- Uploads ------------------------------------------------------------------
# s3 = presigned uploads (set AWS credentials above); local = disk storage for dev.
# UPLOAD_PUBLIC_BASE_URL is the API origin; /uploads is appended automatically.
UPLOAD_DRIVER=local
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:4000

# --- Payments (sandbox / test defaults) --------------------------------------
# Razorpay test keys: https://dashboard.razorpay.com/ (Test Mode)
# Cashfree TEST credentials: https://merchant.cashfree.com/
PAYMENT_DEFAULT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-12-12
CASHFREE_ENVIRONMENT=TEST

# Local webhook URL. For provider dashboard testing, expose the API with a
# tunnel and use https://<tunnel-host>/api/v1/webhooks/razorpay and
# https://<tunnel-host>/api/v1/webhooks/cashfree. Production must be HTTPS.
PAYMENT_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks

# --- Mail / notifications ----------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Artsheaven <no-reply@artsheaven.local>"

# --- Seeded local admin (development only) -----------------------------------
# `npm run prisma:seed` creates:
#   email:    admin@artsheaven.local
#   password: ChangeMe123!
# CHANGE THIS PASSWORD OR DELETE THE ACCOUNT BEFORE ANY SHARED DEPLOYMENT.
