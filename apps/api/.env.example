# --- API ---
NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:5173,http://localhost:8080
API_URL=http://localhost:4000/api/v1

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://artsheaven:artsheaven@localhost:5432/artsheaven?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_TTL=7d
JWT_EMAIL_VERIFY_SECRET=replace-with-email-verify-secret
JWT_PASSWORD_RESET_SECRET=replace-with-password-reset-secret
BCRYPT_ROUNDS=12

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- AWS S3 ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=artsheaven-dev
AWS_S3_PUBLIC_BASE_URL=

# --- Uploads (local disk for dev; use s3 in production) ---
# UPLOAD_PUBLIC_BASE_URL is the API origin; /uploads is appended automatically.
UPLOAD_DRIVER=local
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:4000

# --- Payments (sandbox / test defaults — no live credentials here) ---
PAYMENT_DEFAULT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-12-12
CASHFREE_ENVIRONMENT=TEST
PAYMENT_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks

# --- Mail / notifications ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Artsheaven <no-reply@artsheaven.local>"
