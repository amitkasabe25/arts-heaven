// Artsheaven platform schema. PostgreSQL only. All money columns use fixed-point Decimal.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  STORE_MANAGER
  ORDER_MANAGER
  INVENTORY_MANAGER
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  SIMPLE
  VARIABLE
  CUSTOMIZABLE
  BUILD_A_BOX
}

enum CustomizationFieldType {
  TEXT
  TEXTAREA
  IMAGE
  SINGLE_SELECT
  MULTI_SELECT
  COLOR
  DROPDOWN
  NUMBER
  BOOLEAN
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  CUSTOMIZATION_REQUIRED
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  CASHFREE
  COD
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StockMovement {
  PURCHASE
  SALE
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum UploadOwnerType {
  PRODUCT
  CATEGORY
  CUSTOMIZATION
  REVIEW
  BANNER
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles                Role[]
  sessions             Session[]
  emailTokens          EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  addresses            Address[]
  carts                Cart[]
  orders               Order[]
  reviews              Review[]
  couponUsages         CouponUsage[]
  uploadedAssets       UploadedAsset[]
  statusChanges        OrderStatusHistory[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  deletedAt            DateTime?

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  displayName String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions Permission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "products.write", "orders.refund"
  description String?
  createdAt   DateTime @default(now())

  roles Role[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  name       String
  phone      String
  addressLine String
  city       String
  state      String?
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  tagline        String?
  thumbnail      String?
  bannerImage    String?
  seoTitle       String?
  seoDescription String?
  displayOrder   Int       @default(0)
  isVisible      Boolean   @default(true)
  parentId       String?
  parent         Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryTree")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  products              Product[]
  customizationSchemas  ProductCustomizationSchema[]
  coupons               Coupon[]

  @@index([parentId])
  @@index([displayOrder])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String?       @unique
  shortDescription String?
  description      String?
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  basePrice        Decimal       @db.Decimal(12, 2)
  sellingPrice     Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  status           ProductStatus @default(ACTIVE)
  productType      ProductType   @default(SIMPLE)
  isFeatured       Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  trackStock       Boolean       @default(true)
  stockQty         Int           @default(0)
  lowStockThreshold Int          @default(5)
  weightGrams      Int?
  dimensions       Json?
  seoTitle         String?
  seoDescription   String?
  ratingAverage    Decimal       @default(0) @db.Decimal(2, 1)
  ratingCount      Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  images               ProductImage[]
  variants             ProductVariant[]
  attributes           ProductAttribute[]
  customizationSchemas ProductCustomizationSchema[]
  inventories          Inventory[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  reviews              Review[]
  coupons              Coupon[]
  relatedProducts      Product[]     @relation("RelatedProducts")
  relatedOf            Product[]     @relation("RelatedProducts")

  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([sellingPrice])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String?   @unique
  options        Json      @default("{}") // { "size": "Deluxe", "color": "Lavender" }
  price          Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  stockQty       Int       @default(0)
  isActive       Boolean   @default(true)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  inventories Inventory[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId, isActive])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  position  Int      @default(0)

  @@index([productId])
}

model ProductCustomizationSchema {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isRequired  Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields ProductCustomizationField[]

  @@index([productId])
  @@index([categoryId])
}

model ProductCustomizationField {
  id          String                 @id @default(cuid())
  schemaId    String
  schema      ProductCustomizationSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        CustomizationFieldType
  description String?
  placeholder String?
  isRequired  Boolean                @default(false)
  position    Int                    @default(0)
  // options: [{ value, label, priceDelta, hex? }], validation: { min, max, maxLength, pattern, accept, maxBytes }
  options     Json                   @default("[]")
  validation  Json                   @default("{}")
  priceDelta  Decimal                @default(0) @db.Decimal(12, 2)
  createdAt   DateTime               @default(now())

  @@unique([schemaId, key])
  @@index([schemaId, position])
}

model UploadedAsset {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  objectKey    String           @unique
  url          String?
  originalName String
  mimeType     String
  sizeBytes    Int
  ownerType    UploadOwnerType
  ownerId      String?
  createdAt    DateTime         @default(now())

  @@index([ownerType, ownerId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cart & promotions
// ---------------------------------------------------------------------------

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique
  status     CartStatus @default(ACTIVE)
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items CartItem[]
  reservations StockReservation[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model CartItem {
  id                 String   @id @default(cuid())
  cartId             String
  cart               Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Snapshot protects the cart from catalogue edits and holds custom boxes.
  productSnapshot    Json
  quantity           Int      @default(1)
  customizations     Json     @default("[]")
  uploadedAssetIds   String[] @default([])
  unitPriceSnapshot  Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([cartId])
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  minSubtotal     Decimal    @default(0) @db.Decimal(12, 2)
  maxDiscount     Decimal?   @db.Decimal(12, 2)
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productId       String?
  product         Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  startsAt        DateTime   @default(now())
  expiresAt       DateTime?
  usageLimit      Int?
  perCustomerLimit Int?
  firstOrderOnly  Boolean    @default(false)
  isActive        Boolean    @default(true)
  description     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  usages CouponUsage[]

  @@index([isActive, expiresAt])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([orderId])
}

model DeliveryZone {
  id              String   @id @default(cuid())
  name            String
  pincodePrefixes String[] @default([])
  deliveryFee     Decimal  @db.Decimal(12, 2)
  freeAbove       Decimal? @db.Decimal(12, 2)
  estimatedDaysMin Int     @default(1)
  estimatedDaysMax Int     @default(2)
  sameDayEligible Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

model DeliverySlot {
  id         String   @id @default(cuid())
  code       String   @unique
  label      String
  windowText String
  fee        Decimal  @db.Decimal(12, 2) @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GiftWrap {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Orders & money movement
// ---------------------------------------------------------------------------

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail      String?
  guestPhone      String?
  status          OrderStatus    @default(PENDING)
  customerSnapshot Json
  addressSnapshot Json
  deliveryDate    DateTime?
  deliverySlotId  String?
  giftWrapId      String?
  cardMessage     String?
  adminNotes      String?
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal        @default(0) @db.Decimal(12, 2)
  giftWrapFee     Decimal        @default(0) @db.Decimal(12, 2)
  slotFee         Decimal        @default(0) @db.Decimal(12, 2)
  tax             Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  currency        String         @default("INR")
  idempotencyKey  String?        @unique
  guestToken      String?
  paymentProvider PaymentProvider
  cancelledAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  refunds        Refund[]
  reservations   StockReservation[]
  reviews        Review[]
  notifications  Notification[]
  couponUsages   CouponUsage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  nameSnapshot       String
  skuSnapshot        String?
  imageSnapshot      String?
  variantSnapshot    Json    @default("{}")
  customizations     Json    @default("[]")
  uploadedAssetIds   String[] @default([])
  unitPrice          Decimal @db.Decimal(12, 2)
  quantity           Int
  lineTotal          Decimal @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus     OrderStatus?
  toStatus       OrderStatus
  note           String?
  changedByUserId String?
  changedBy      User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         PaymentProvider
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  providerOrderId  String?
  providerPaymentId String?
  method           String?
  idempotencyKey   String?       @unique
  attempts         Int           @default(0)
  failureReason    String?
  metadata         Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  refunds Refund[]

  @@index([orderId])
  @@index([providerPaymentId])
}

model PaymentWebhookEvent {
  id               String   @id @default(cuid())
  provider         PaymentProvider
  externalId       String
  eventType        String
  payload          Json
  signatureVerified Boolean @default(false)
  processedAt      DateTime?
  error            String?
  createdAt        DateTime @default(now())

  @@unique([provider, externalId])
  @@index([processedAt])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus @default(PENDING)
  providerRefundId String?
  idempotencyKey   String       @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Inventory {
  id               String   @id @default(cuid())
  // Exactly one of productId / variantId is set; stockKey enforces uniqueness for both.
  stockKey         String   @unique // "p:<productId>" or "v:<variantId>"
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity         Int      @default(0)
  reserved         Int      @default(0)
  lowStockThreshold Int     @default(5)
  updatedAt        DateTime @updatedAt

  transactions  InventoryTransaction[]
  reservations  StockReservation[]

  @@index([productId])
  @@index([variantId])
}

model InventoryTransaction {
  id            String        @id @default(cuid())
  inventoryId   String
  inventory     Inventory     @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  movement      StockMovement
  quantity      Int // signed: positive increases, negative decreases
  reason        String?
  referenceType String?
  referenceId   String?
  createdAt     DateTime      @default(now())

  @@index([inventoryId, createdAt])
}

model StockReservation {
  id          String            @id @default(cuid())
  inventoryId String
  inventory   Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  cartId      String?
  cart        Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, expiresAt])
  @@index([orderId])
  @@index([cartId])
}

// ---------------------------------------------------------------------------
// Engagement & operations
// ---------------------------------------------------------------------------

model Review {
  id                String       @id @default(cuid())
  productId         String
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating            Int
  title             String?
  body              String
  status            ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean     @default(false)
  imageUrls         String[]     @default([])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
}

model Notification {
  id                String              @id @default(cuid())
  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId           String?
  order             Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  eventType         String
  recipient         String
  subject           String?
  body              String
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0)
  providerMessageId String?
  error             String?
  scheduledAt       DateTime?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([status, scheduledAt])
  @@index([orderId])
}

model StoreSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model HomepageBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  link      String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @unique
  scope        String
  fingerprint  String?
  result       Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}
